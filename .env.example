# Zorunlu Temel Ayarlar
OWNER_PHONE=
ASSISTANT_NAME=Veko
ASSISTANT_STYLE=

# ------------------------------------------------------------------
# ÖNERİLEN KURULUM: Google Gemini (Ses + Metin aynı anahtarla çalışır)
# ------------------------------------------------------------------
GEMINI_API_KEY=
AI_VOICE_PROVIDER=gemini
GEMINI_LIVE_MODEL=gemini-3.8-live
TTS_VOICE_NAME=Aoede
AI_TEXT_PROVIDER=gemini
GEMINI_TEXT_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------
# Alternatif Ses Sağlayıcıları (AI_VOICE_PROVIDER: gemini | openai | none)
# ------------------------------------------------------------------
# OpenAI Realtime API (GA: gpt-realtime-2.1, Beta Preview: gpt-4o-realtime-preview):
# AI_VOICE_PROVIDER=openai
# OPENAI_API_KEY=
# AI_VOICE_MODEL=gpt-realtime-2.1
# AI_VOICE_NAME=cedar
# Sesli aramayı tamamen kapatıp yalnızca yazılı asistan kullanmak için:
# AI_VOICE_PROVIDER=none

# ------------------------------------------------------------------
# Alternatif Metin Sohbet Sağlayıcıları
# (gemini | openai | deepseek | ollama | anthropic | openrouter | groq | xai | openai-compatible | none)
# ------------------------------------------------------------------
# DeepSeek:
# AI_TEXT_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# AI_TEXT_MODEL=deepseek-v4-flash

# Yerel Ollama (API anahtarı gerekmez):
# AI_TEXT_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen3:8b
# Ollama Cloud (bulut uç noktası kullanılırsa API anahtarı zorunludur):
# OLLAMA_BASE_URL=https://ollama.com/v1
# OLLAMA_API_KEY=

# Anthropic Claude:
# AI_TEXT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AI_TEXT_MODEL=claude-sonnet-4-5

# Diğer OpenAI Uyumlu Sağlayıcılar (Groq / xAI / OpenRouter / Özel):
# AI_TEXT_PROVIDER=groq
# GROQ_API_KEY=
# AI_TEXT_PROVIDER=xai
# XAI_API_KEY=
# AI_TEXT_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# AI_TEXT_PROVIDER=openai-compatible
# AI_TEXT_BASE_URL=http://127.0.0.1:8080/v1
# AI_TEXT_MODEL=local-model
# AI_TEXT_API_KEY=

# ------------------------------------------------------------------
# İşletme Zamanlama, Tarayıcı ve Durum Ayarları
# ------------------------------------------------------------------
COOLDOWN_MINUTES=120
MISSED_RETRY_MINUTES=30
OWNER_ACTIVE_WINDOW_MINUTES=15
CALL_RING_TIMEOUT_SEC=35
CALL_MAX_DURATION_SEC=300
THIRD_PARTY_OUTREACH_HOURS=24
CHROME_HEADLESS=new
CHROME_EXECUTABLE_PATH=
STATE_FILE_PATH=./data/state.json

# İsteğe bağlı sürüm/güncelleme kontrolü (Fork kullanırsanız değiştirebilirsiniz)
# GITHUB_REPO_URL=https://github.com/holy2k/veko
# UPDATE_CHECK_URL=https://raw.githubusercontent.com/holy2k/veko/main/package.json
# GITHUB_REPO_URL=https://github.com/holy2k/veko
# UPDATE_CHECK_URL=https://raw.githubusercontent.com/holy2k/veko/main/package.json
